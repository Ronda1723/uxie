<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Mic capture for voice commands. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>

  <!-- Electron's V8 needs JIT. allow-jit is the narrow, Apple-recommended
       form; allow-unsigned-executable-memory is the broader fallback some
       Electron versions need until V8 ships fully signed-memory pages. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- Outbound HTTPS (Railway, Deepgram, Apple notary). -->
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
